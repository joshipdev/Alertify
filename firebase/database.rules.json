{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        "status": {
          ".write": "auth != null"
        },
        "sensors": {
          ".write": "auth != null"
        },
        "commands": {
          "armed": {
            ".write": "auth != null"
          }
        }
      }
    },
    "events": {
      "$deviceId": {
        ".read": "auth != null",
        "$eventId": {
          ".write": "auth != null"
        }
      }
    }
  }
}
